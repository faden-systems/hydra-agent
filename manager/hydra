#!/usr/bin/env python3
"""hydra: the console side of the manager. Slack drives; the console observes and repairs.

  hydra status                 engine, last turn, queue depth, tracks
  hydra say "<text>"           queue a console instruction; print the reply (mirrored to #dev as "from L via console")
  hydra logs [n]               the last n turns
  hydra tail <channel> [n]     the last n mirrored messages of a channel
  hydra engine [acc=<a>] [model=<m>]  show or set the engine: acc claude-r2d2 | claude-l | codex, model an alias
                               from models.json (fable5.1, sonnet5, opus5, haiku4.5; gpt6/astra, gpt5.6/sol) or a
                               full id; `hydra engine <acc>` still works and means the family default model
  hydra pause [reason]         create PAUSE; hydra resume removes it
  hydra attach                 take WRITER and run the manager session interactively; releases on exit
  hydra compact                force a compaction of the manager's Claude session (the COMPACT flag; it runs
                               before the next turn; with a live loop, waits for it and prints the outcome)
  hydra post <channel> <thread_ts|-> <text>
                               post to Slack from inside a turn (loops/b6.md): the line goes to inbox/outbox.jsonl
                               and the bridge posts it through the manager's one posting path, so the thread is
                               joined and the post mirrored; `-` posts top level. Text may come on stdin. With a
                               live bridge, waits for the post and prints `posted`.
  hydra update                 fast-forward main in the hydra-agent clone, re-copy manager/ into the deploy dir,
                               refresh the AGENTS.md link, restart hydra-bridge and hydra-manager, print the new
                               commit. The git steps run as hydra (`sudo -n -u hydra -H git` when root); the copy,
                               the link and the restarts need root: run as anyone else, it stops after the git
                               steps and prints `sudo -n hydra update` for the rest.

Honours HYDRA_HOME (default /srv/hydra/manager); `update` also honours HYDRA_REPO (default
/srv/hydra/repos/hydra-agent) and HYDRA_APP (default /srv/hydra/manager/app/manager), and HYDRA_FAKE_UID (an
integer that stands in for the effective uid, the acceptance harness's injection).
"""
import getpass
import json
import os
import shutil
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import supervisor as S  # noqa: E402


def who():
    try:
        return f"{getpass.getuser()}@console"
    except Exception:
        return "console"


def supervisor_alive(home):
    """True when a service loop (not a one-off run_once) is running: its pid file names a live process."""
    pid = S.read_text(os.path.join(home, "logs", "supervisor.pid")).strip()
    return pid.isdigit() and S.pid_alive(int(pid))


def cmd_status(home, args):
    print(S.status_text(home))
    return 0


def cmd_say(home, args):
    if not args:
        print("usage: hydra say \"<text>\"", file=sys.stderr)
        return 2
    text = " ".join(args)
    cfg = S.load_config(home)
    ev = S.append_event(home, S.new_event("cli", {"text": text, "user": "founder-console", "instructs": True,
                                                 "channel": cfg.get("dev_channel") or S.DEFAULT_DEV_CHANNEL,
                                                 "thread_ts": None}))
    reply_path = os.path.join(home, "inbox", "replies", f"{ev['id']}.txt")
    timeout = float(os.environ.get("HYDRA_SAY_TIMEOUT", "600"))
    if not supervisor_alive(home):
        print(f"queued {ev['id']}; no live supervisor loop, the reply will land in {reply_path}")
        return 0
    print(f"queued {ev['id']}; waiting for the reply", file=sys.stderr)
    deadline = time.time() + timeout
    while time.time() < deadline:
        if os.path.exists(reply_path):
            print(S.read_text(reply_path).rstrip())
            return 0
        time.sleep(1)
    print(f"no reply within {timeout:.0f}s; it will land in {reply_path}", file=sys.stderr)
    return 1


def cmd_logs(home, args):
    n = int(args[0]) if args else 10
    for t in S.read_jsonl(os.path.join(home, "logs", "turns.jsonl"))[-n:]:
        when = S.now_iso(t.get("at")) if isinstance(t.get("at"), (int, float)) else t.get("at")
        line = f"{when} turn {t.get('n', '?')} {t.get('engine')} events={len(t.get('events') or [])} {t.get('duration_s', 0):.0f}s"
        if t.get("kind"):
            line += f" kind={t['kind']}"
        if t.get("tokens") is not None:
            line += f" tokens={t['tokens']}"
        if t.get("input_tokens") is not None:
            line += f" input_tokens={t['input_tokens']}"
        if t.get("error"):
            line += f" error={t['error'][:120]}"
        print(line)
    return 0


def cmd_tail(home, args):
    if not args:
        print("usage: hydra tail <channel> [n]", file=sys.stderr)
        return 2
    n = int(args[1]) if len(args) > 1 else 20
    path = os.path.join(home, "mirror", f"{args[0]}.jsonl")
    if not os.path.exists(path):
        print(f"no mirror for {args[0]}", file=sys.stderr)
        return 1
    for r in S.read_jsonl(path)[-n:]:
        print(f"{r.get('ts')} {r.get('user') or r.get('bot_id') or '-'}: {(r.get('text') or r.get('reaction') or '')}")
    return 0


def cmd_engine(home, args):
    current = S.read_engine(home)
    if not args:
        print(f"engine: {S.engine_label(current)}")
        return 0
    try:
        pair = S.parse_engine_command(" ".join(args), current=current)
    except S.BadEngine as e:
        print(f"{e}; nothing changed (engine: {S.engine_label(current)})", file=sys.stderr)
        return 2
    S.set_engine(home, pair["acc"], pair["model"])
    print(f"engine: {S.engine_label(pair)}")
    return 0


def cmd_pause(home, args):
    reason = " ".join(args) if args else who()
    S.write_text(os.path.join(home, "PAUSE"), reason + "\n")
    print(f"paused (by {reason})")
    return 0


def cmd_resume(home, args):
    p = os.path.join(home, "PAUSE")
    if os.path.exists(p):
        os.remove(p)
        print("resumed")
    else:
        print("not paused")
    return 0


def cmd_attach(home, args):
    """Take WRITER, run the manager session interactively, release, post a two-line summary to #dev."""
    cfg = S.load_config(home)
    engines = S.default_engines(home, cfg)
    engine = S.current_engine(home)
    if engine not in engines or engine == "codex":
        engine = next((n for n in S.ENGINE_ORDER if n in engines and n != "codex"), engine)
    spec = engines[engine]
    sup = S.Supervisor(home=home, engines=engines, poster=lambda *a: None, config=cfg)
    sid = sup.session_id()
    pair = S.read_engine(home, engines)
    model = pair["model"] if pair["acc"] == engine else S.family_default_model("claude", sup.models)
    argv = [spec["bin"]] + (["--resume", sid] if sid else []) + ["--model", model] + list(args)
    me = who()
    started = time.time()
    try:
        with S.acquire_writer(home, me):
            rc = subprocess.call(argv, env=sup.engine_env(spec), cwd=home)
    except S.WriterHeld as e:
        print(f"cannot attach: {e}", file=sys.stderr)
        return 1
    ended = time.time()
    summary = (f"console session by {me} (hydra attach): {S.now_iso(started)} to {S.now_iso(ended)}, "
               f"{(ended - started) / 60:.0f} min, exit {rc}\n"
               f"engine {engine}, session {sid or 'new'}; the manager's next turn reads MANAGER-HANDOFF.md and state.json")
    try:
        S.default_poster(home, echo=False)(cfg.get("dev_channel") or S.DEFAULT_DEV_CHANNEL, None, summary)
    except Exception as e:
        print(f"summary not posted: {e}", file=sys.stderr)
    print(summary)
    return rc


def cmd_compact(home, args):
    """Write the COMPACT flag; with a live loop, wait for the compaction and print its outcome (0 ok, 1 failed)."""
    def marks():
        st = S.read_compaction_state(home)
        return ((st.get("last") or {}).get("at"), (st.get("verify") or {}).get("at"))
    before = marks()
    S.write_text(os.path.join(home, "COMPACT"), who() + "\n")
    if not supervisor_alive(home):
        print("compaction scheduled (COMPACT): it runs before the manager's next turn; no live supervisor loop right now")
        return 0
    timeout = float(os.environ.get("HYDRA_COMPACT_TIMEOUT", "900"))
    print("compaction scheduled; waiting for the supervisor", file=sys.stderr)
    deadline = time.time() + timeout
    while time.time() < deadline:
        now = marks()
        if now != before and not os.path.exists(os.path.join(home, "COMPACT")):
            st = S.read_compaction_state(home)
            last, verify = st.get("last") or {}, st.get("verify") or {}
            if verify and verify.get("at") != before[1]:
                print(f"compacted at {verify.get('at')} ({verify.get('before_tokens')} input tokens before); "
                      "the next turn verifies the reduction and `hydra status` shows it")
                return 0
            if last.get("ok") is False:
                print(f"compaction failed at {last.get('at')}: {last.get('error')}; the session is unchanged")
                return 1
            print(f"compaction at {last.get('at')}: {last.get('before_tokens')} -> {last.get('after_tokens')}")
            return 0
        time.sleep(1)
    print(f"no compaction within {timeout:.0f}s; the COMPACT flag stays, it runs before the next turn", file=sys.stderr)
    return 1


def cmd_post(home, args):
    """`hydra post <channel> <thread_ts|-> <text...>`: queue one line in inbox/outbox.jsonl for the bridge. The text
    is the remaining arguments, or stdin when there are none. With a live bridge (logs/bridge.pid) waits up to
    HYDRA_POST_TIMEOUT (default 30 s) for the post to go out: 0 and `posted`, 1 when it failed or is still queued."""
    if len(args) < 2:
        print("usage: hydra post <channel> <thread_ts|-> <text...>  (text may come on stdin)", file=sys.stderr)
        return 2
    channel, thread_ts = args[0], args[1]
    text = " ".join(args[2:]) if len(args) > 2 else ("" if sys.stdin.isatty() else sys.stdin.read())
    text = text.strip("\n")
    if not text.strip():
        print("usage: hydra post <channel> <thread_ts|-> <text...>: no text given", file=sys.stderr)
        return 2
    import bridge as B  # noqa: E402  (imports supervisor, which is already loaded)
    rec = S.queue_post(home, channel, thread_ts, text, user=who())
    if not B.bridge_alive(home):
        print(f"queued {rec['id']} in inbox/outbox.jsonl; the bridge posts it when it runs")
        return 0
    timeout = float(os.environ.get("HYDRA_POST_TIMEOUT", "30"))
    deadline = time.time() + timeout
    while time.time() < deadline:
        if not any(it.get("id") == rec["id"] for it in S.read_outbox(home)):
            failed = next((it for it in S.read_jsonl(S.outbox_failed_path(home)) if it.get("id") == rec["id"]), None)
            if failed:
                print(f"post failed after {failed.get('attempts')} attempts: {failed.get('error')}", file=sys.stderr)
                return 1
            print(f"posted to {channel}/{thread_ts or '-'}")
            return 0
        time.sleep(0.2)
    print(f"post {rec['id']} still queued after {timeout:.0f}s; the bridge posts it when it catches up", file=sys.stderr)
    return 1


DEFAULT_REPO = "/srv/hydra/repos/hydra-agent"
DEFAULT_APP = "/srv/hydra/manager/app/manager"
SERVICES = ("hydra-bridge", "hydra-manager")
SERVICE_USER = "hydra"  # owns the hydra-agent clone; git runs as it (loops/b6.md)
ROOT_COMMAND = "sudo -n hydra update"


def effective_uid():
    """The uid `update` decides by: HYDRA_FAKE_UID when set (the acceptance harness's injection), else the real
    effective uid. Raises ValueError on a malformed HYDRA_FAKE_UID."""
    fake = os.environ.get("HYDRA_FAKE_UID")
    if fake is None or fake == "":
        return os.geteuid()
    return int(fake)


def _git(repo, *args, as_user=None):
    argv = ["git", "-C", repo, *args]
    if as_user:
        argv = ["sudo", "-n", "-u", as_user, "-H", *argv]
    return subprocess.run(argv, capture_output=True, text=True, timeout=300)


def cmd_update(home, args):
    """The git steps as hydra, the deploy as root (loops/b6.md): fast-forward main in the clone (as root: every git
    call through `sudo -n -u hydra -H`, so git's ownership check on the hydra-owned clone passes; otherwise directly,
    as the caller), then, as root, redeploy manager/ into $HYDRA_APP, refresh $HYDRA_HOME/CLAUDE.md and the AGENTS.md
    link, restart both services. Any other caller stops after the git steps and prints the root command for the
    rest instead of failing on the root-owned deploy dir."""
    repo = os.environ.get("HYDRA_REPO") or DEFAULT_REPO
    app = os.path.abspath(os.environ.get("HYDRA_APP") or DEFAULT_APP)
    try:
        uid = effective_uid()
    except ValueError:
        print(f"update: HYDRA_FAKE_UID must be an integer, not {os.environ.get('HYDRA_FAKE_UID')!r}", file=sys.stderr)
        return 2
    as_root = uid == 0
    git_user = SERVICE_USER if as_root else None
    if not os.path.isdir(os.path.join(repo, ".git")):
        print(f"update: {repo} is not a git clone (set HYDRA_REPO)", file=sys.stderr)
        return 1
    fetch = _git(repo, "fetch", "-q", "origin", "main", as_user=git_user)
    if fetch.returncode != 0:
        print(f"update: fetch failed: {fetch.stderr.strip()}", file=sys.stderr)
        return 1
    branch = _git(repo, "rev-parse", "--abbrev-ref", "HEAD", as_user=git_user).stdout.strip()
    if branch != "main":
        co = _git(repo, "checkout", "-q", "main", as_user=git_user)
        if co.returncode != 0:
            print(f"update: cannot check out main in {repo}: {co.stderr.strip()}", file=sys.stderr)
            return 1
    merge = _git(repo, "merge", "-q", "--ff-only", "origin/main", as_user=git_user)
    if merge.returncode != 0:
        print(f"update: main in {repo} does not fast-forward: {merge.stderr.strip()}", file=sys.stderr)
        return 1
    head = _git(repo, "rev-parse", "HEAD", as_user=git_user).stdout.strip()
    source = os.path.join(repo, "manager")
    if not os.path.isfile(os.path.join(source, "supervisor.py")):
        print(f"update: {source} has no supervisor.py", file=sys.stderr)
        return 1
    if not as_root:
        print(f"main in {repo} is at {head[:12]}; the copy into {app}, the AGENTS.md link and the restart of "
              f"{' '.join(SERVICES)} need root: run `{ROOT_COMMAND}`")
        return 0
    # Stage the new copy next to the deploy dir, then swap, so a failed copy never leaves a half-deployed app.
    staging, old = app + ".new", app + ".old"
    for d in (staging, old):
        if os.path.isdir(d):
            shutil.rmtree(d)
    shutil.copytree(source, staging, ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
    for name in ("hydra", "supervisor.py", "bridge.py"):
        f = os.path.join(staging, name)
        if os.path.exists(f):
            os.chmod(f, 0o755)
    if os.path.isdir(app):
        os.rename(app, old)
    os.makedirs(os.path.dirname(app), exist_ok=True)
    os.rename(staging, app)
    if os.path.isdir(old):
        shutil.rmtree(old, ignore_errors=True)
    # Claude reads $HYDRA_HOME/CLAUDE.md (a copy installed by bootstrap); Codex reads the AGENTS.md link.
    rules = os.path.join(app, "CLAUDE.md")
    if os.path.isfile(rules):
        shutil.copyfile(rules, os.path.join(home, "CLAUDE.md"))
        agents = os.path.join(home, "AGENTS.md")
        if os.path.lexists(agents):
            os.remove(agents)
        os.symlink(os.path.relpath(rules, home), agents)
    restart = subprocess.run(["systemctl", "restart", *SERVICES], capture_output=True, text=True, timeout=300)
    if restart.returncode != 0:
        print(f"update: deployed {head[:12]} but systemctl restart failed: {(restart.stderr or restart.stdout).strip()}",
              file=sys.stderr)
        return 1
    print(f"updated to {head[:12]} (deployed {app}, restarted {' '.join(SERVICES)})")
    return 0


COMMANDS = {"status": cmd_status, "say": cmd_say, "logs": cmd_logs, "tail": cmd_tail, "engine": cmd_engine,
            "pause": cmd_pause, "resume": cmd_resume, "attach": cmd_attach, "compact": cmd_compact, "post": cmd_post,
            "update": cmd_update}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help") or argv[0] not in COMMANDS:
        print(__doc__.strip())
        return 0 if argv and argv[0] in ("-h", "--help", "help") else 2
    home = S.home_dir()
    return COMMANDS[argv[0]](home, argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
